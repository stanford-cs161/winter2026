{% assign components = site.components | where: 'type', include.type | sort: 'number' %} 
{% for component in components %} 
    {% assign release_date = component.times[0].begin %}
    {% assign is_restricted = "homework,lecture" | split: "," %}

    {% if is_restricted contains component.type %}
        {% if release_date <= site.time %}
            {{ component }} 
        {% endif %}
    {% else %}
        {{ component }} 
    {% endif %}
{% endfor %}